# ── Обязательное ──────────────────────────────────────────────────────
# Токен бота от @BotFather в Telegram (напиши ему /newbot).
BOT_TOKEN=123456:ABC-DEF...

# ── Субтитры ──────────────────────────────────────────────────────────
# whisper-cpp = локально и бесплатно (сейчас). Позже: openai
SUBTITLE_ENGINE=whisper-cpp
# Модель распознавания: medium (баланс) | large-v3-turbo (точнее) | small (быстро)
WHISPER_MODEL=medium
WHISPER_LANG=ru
# Понадобится, только если SUBTITLE_ENGINE=openai
OPENAI_API_KEY=

# ── Ограничения / прочее (можно не трогать) ───────────────────────────
MAX_DURATION_SEC=120
MAX_FILE_SIZE_MB=50
STATIC_PORT=8787
RENDER_CONCURRENCY=2
ACCENT_COLOR=#FFD84D
WORK_DIR=./.work
WHISPER_DIR=./.whisper

# ══ АВТОПУБЛИКАЦИЯ (Instagram + ВКонтакте) ════════════════════════════
# Подробная инструкция, откуда брать каждый токен — в PUBLISH.md.

# ── Где лежит контент ─────────────────────────────────────────────────
CONTENT_DIR=./content
# Журнал публикаций. На сервере держи его на постоянном диске, иначе после
# передеплоя система забудет, что уже опубликовала (и выложит повторно).
STATE_FILE=./content/.state.json
# Часовой пояс, в котором записано время в контент-плане.
TIMEZONE=Europe/Moscow
# Как часто проверять план (сек) и сколько ждать опоздавшие посты (мин).
SCHEDULER_INTERVAL_SEC=60
PUBLISH_GRACE_MIN=180
PUBLISH_MAX_ATTEMPTS=3
# true — ничего не публиковать, только писать в лог, что было бы отправлено.
PUBLISH_DRY_RUN=false
# true — запускать планировщик прямо внутри бота (один процесс на всё).
PUBLISH_SCHEDULER_IN_BOT=false

# ── Публичный доступ к медиа (нужен Instagram: он скачивает файл сам) ──
# local — раздаём файлы сами (нужен публичный домен сервиса)
# s3    — заливаем в S3-совместимое хранилище (Yandex/Selectel/MinIO/AWS)
# none  — в плане указаны готовые http-ссылки на файлы
MEDIA_HOST=local
PUBLIC_BASE_URL=
MEDIA_PORT=8788
S3_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=publish/
S3_PUBLIC_BASE_URL=
S3_SIGNED_URL_TTL_SEC=3600

# ── Instagram (аккаунт Business/Creator + приложение Meta) ────────────
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v21.0
IG_SHARE_REELS_TO_FEED=true
IG_VIDEO_TIMEOUT_SEC=300

# ── ВКонтакте (ключ доступа сообщества: wall, photos, video) ──────────
VK_GROUP_ID=
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
VK_FROM_GROUP=true
# Экспериментально: заливать вертикальные ролики как Клипы. Метод открыт
# не всем приложениям — при ошибке ролик уйдёт обычным видео.
VK_CLIPS_FOR_REELS=false

# ── Уведомления о публикациях (в Telegram, тем же ботом) ──────────────
NOTIFY_CHAT_ID=
NOTIFY_ON_SUCCESS=true
